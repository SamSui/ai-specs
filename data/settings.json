        "source": "github"
      }
    },
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/everything-claude-code.git"
      }
    },
    "obsidian-skills": {
      "source": {
        "repo": "kepano/obsidian-skills",
        "source": "github"
      }
    },
    "piebald-lsps": {
      "source": {
        "repo": "Piebald-AI/claude-code-lsps",
